# Copy to .env and edit per machine/network. All values are optional.
# cp .env.example .env

# --- branch-watcher ---------------------------------------------------------
# The repo to watch. In Docker this is the path ON YOUR HOST; it gets mounted
# into the container at /repo. e.g. BW_REPO=/home/user/projects/my-repo
BW_REPO=
# How that repo is mounted into the container: rw (default, needed for the
# 'git fetch' that keeps origin/develop fresh) or ro (read-only).
BW_REPO_MOUNT=rw
# SSH keys for fetching a git@github.com:... remote. Mounted read-only into the
# mailer. Defaults to your ~/.ssh; point it elsewhere if your key lives
# somewhere else (see "SSH ile fetch" in the README).
BW_SSH_DIR=
# Target branch to compare against
BW_TARGET=origin/develop
# Address the WEB UI binds to inside the container — leave it at 0.0.0.0.
# This is NOT the mail server: that is BW_SMTP_HOST, further down. Putting a
# hostname here makes the web container die with "Cannot assign requested
# address" (it can only bind an address it actually owns).
BW_HOST=0.0.0.0
# Port the web UI is published on (host side too).
BW_PORT=9534
# Web UI auto-refresh interval (seconds)
BW_REFRESH=30
# Run 'git fetch' before each comparison (true/false)
BW_FETCH=false
# Start the web backend by default, so you can run with no CLI args (true/false)
BW_SERVE=false

# --- daily e-mail report ----------------------------------------------------
# Every morning the mailer compares your current branch against BW_TARGET and
# mails the result (ahead/behind + commit lists + "merge needed?") to everyone
# in BW_MAIL_TO. Nothing here is baked into the image — these are YOUR
# credentials, they stay in this file, and .env is gitignored. Never commit it.
#
# When to send, and in which timezone. 09:15 Europe/Istanbul = 09:15 UTC+3.
BW_MAIL_TIME=09:15
BW_MAIL_TZ=Europe/Istanbul
# Everyone who should get the report: comma separated.
BW_MAIL_TO=
# Sender. Leave BW_MAIL_FROM empty to reuse BW_SMTP_USER.
BW_MAIL_FROM=
BW_MAIL_FROM_NAME=Branch Watcher
BW_MAIL_SUBJECT_PREFIX=[branch-watcher]
# 'git fetch' before comparing, so 'behind' reflects today's develop (true/false)
BW_MAIL_FETCH=true
# Also send one mail right when the container starts — use it once to verify
# your SMTP settings, then set it back to false.
BW_MAIL_ON_START=false
# Only mail when there is actually something to merge (true = stay quiet on
# green days, false = a report every morning).
BW_MAIL_ONLY_WHEN_BEHIND=false
# Retry a failed send this many times, waiting this many seconds between tries.
BW_MAIL_RETRIES=3
BW_MAIL_RETRY_DELAY=30

# --- SMTP (your own mail account) -------------------------------------------
# Gmail:    smtp.gmail.com / 587 / starttls  — BW_SMTP_PASS must be a 16-char
#           "App password" from https://myaccount.google.com/apppasswords (needs
#           2-Step Verification on), NOT your normal login password.
#           Step-by-step: see "Gmail ile SMTP" in the README.
# Outlook:  smtp.office365.com / 587 / starttls
# Yandex:   smtp.yandex.com / 465 / ssl
# Local relay with no auth: set BW_SMTP_SECURITY=none and leave USER/PASS empty.
BW_SMTP_HOST=
BW_SMTP_PORT=587
BW_SMTP_USER=
# If the password contains spaces or a '#', wrap it in quotes: BW_SMTP_PASS="a b#c"
BW_SMTP_PASS=
# starttls (587) / ssl (465) / none
BW_SMTP_SECURITY=starttls
BW_SMTP_TIMEOUT=30

# --- logging ----------------------------------------------------------------
# Log verbosity: DEBUG / INFO / WARNING / ERROR
BW_LOG_LEVEL=INFO
# Where to write the log file (rotates at ~1MB, keeps 3 backups)
BW_LOG_FILE=branch_watcher.log
