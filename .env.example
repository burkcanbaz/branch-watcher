# Copy to .env and edit per machine/network. All values are optional.
# cp .env.example .env

# --- branch-watcher ---------------------------------------------------------
# Default repo path (so you can run without passing it on the CLI)
BW_REPO=YOUR_BRANCH_REPO_PATH
# Target branch to compare against
BW_TARGET=origin/develop
# Backend bind host (0.0.0.0 = reachable from the LAN) and port
BW_HOST=0.0.0.0
BW_PORT=9534
# Web UI auto-refresh interval (seconds)
BW_REFRESH=30
# Run 'git fetch' before each comparison (true/false)
BW_FETCH=false
# Start the web backend by default, so you can run with no CLI args (true/false)
BW_SERVE=true
# Lock the backend port down to a single client IP (ufw). Empty = open to the
# LAN. Needs passwordless sudo for ufw (run scripts/setup-permissions.sh once,
# or use the Docker image which has it baked in). The only IP allowed to reach
# the port:
BW_ALLOW_IP=

# --- logging ----------------------------------------------------------------
# Log verbosity: DEBUG / INFO / WARNING / ERROR
BW_LOG_LEVEL=INFO
# Where to write the log file (rotates at ~1MB, keeps 3 backups)
BW_LOG_FILE=branch_watcher.log
